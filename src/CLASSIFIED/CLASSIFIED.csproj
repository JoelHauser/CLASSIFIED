<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 because that is what the game's mono runtime loads. -->
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>CLASSIFIED</RootNamespace>
    <AssemblyName>CLASSIFIED</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <!-- Must match ClassifiedPlugin.PluginVersion. -->
    <Version>0.1.0</Version>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <SPTPath Condition="'$(SPTPath)' == ''">H:\SPT4.1.X</SPTPath>
    <GameManaged>$(SPTPath)\EscapeFromTarkov_Data\Managed</GameManaged>
    <BepInExCore>$(SPTPath)\BepInEx\core</BepInExCore>
    <PluginDeployDir>$(SPTPath)\BepInEx\plugins</PluginDeployDir>
  </PropertyGroup>

  <Target Name="ValidateSPTPath" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll')"
           Text="SPTPath ('$(SPTPath)') is not an SPT install root: no BepInEx\core\BepInEx.dll." />
    <!--
      The source names no obfuscated type, so it compiles against either the patched or the
      untouched Assembly-CSharp. Only a build against the patched one (which the SPT Launcher
      writes the first time the game starts, keeping the original as .spt-bak) runs in game, so
      a release build insists on it. -p:CompileCheckOnly=true skips the check, for a machine that
      only has an unpatched install: that DLL is for catching compile errors and must not ship.
    -->
    <Error Condition="'$(CompileCheckOnly)' != 'true' And !Exists('$(GameManaged)\Assembly-CSharp.dll.spt-bak')"
           Text="$(GameManaged)\Assembly-CSharp.dll has not been patched by SPT yet. Start the game through the SPT Launcher once, then build." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(GameManaged)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort.Unity">
      <HintPath>$(GameManaged)\Comfort.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommonExtensions">
      <HintPath>$(GameManaged)\CommonExtensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItemComponent.Types">
      <HintPath>$(GameManaged)\ItemComponent.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItemTemplate.Types">
      <HintPath>$(GameManaged)\ItemTemplate.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(GameManaged)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The showreel: its crossfades capture the screen, and its F12 button is drawn with IMGUI. -->
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(GameManaged)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Decodes the insignia pictures. -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The insignia, made from the logos in art/ by scripts/make_insignia.py. -->
    <EmbeddedResource Include="Resources\insignia_bear.png" LogicalName="CLASSIFIED.insignia_bear.png" />
    <EmbeddedResource Include="Resources\insignia_usec.png" LogicalName="CLASSIFIED.insignia_usec.png" />
    <EmbeddedResource Include="Resources\insignia_unknown.png" LogicalName="CLASSIFIED.insignia_unknown.png" />
    <!-- The debrief's weapons and equipment, made from the game's own models by scripts/make_weapons.py. -->
    <EmbeddedResource Include="Resources\item_*.bin" LogicalName="CLASSIFIED.%(Filename)%(Extension)" />
    <!-- The faction backdrops, drawn by scripts/make_backdrops.py. -->
    <EmbeddedResource Include="Resources\backdrop_*.png" LogicalName="CLASSIFIED.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Opt-in: dotnet build -c Release -p:DeployToSPT=true -->
  <Target Name="DeployToSPT" AfterTargets="Build" Condition="'$(DeployToSPT)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(PluginDeployDir)" />
  </Target>

</Project>
